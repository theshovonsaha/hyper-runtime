# The evaluated v0.1.0 core requires no environment variables or API keys.
# Future provider and capability packages must document variables here and may
# not ship default credentials.

# -----------------------------------------------------------------------------
# Optional Live Providers (for experimental usage only)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
HYPER_PROVIDER=ollama
HYPER_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
HYPER_OLLAMA_MODEL=llama3.2

# Proposal routing: fallback always starts with HYPER_PROVIDER; round_robin
# rotates the starting provider on each model pass, then falls back on failure.
HYPER_MODEL_ROUTING_MODE=fallback
# Pause a repeatedly failing route without spending calls on every pass.
HYPER_MODEL_ROUTE_FAILURE_THRESHOLD=2
HYPER_MODEL_ROUTE_COOLDOWN_PASSES=2
HYPER_PROVIDER_FALLBACK_CHAIN=ollama,anthropic,gemini

# Remote providers become visible when their credential is present.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# OPENCODE_API_KEY=

# Optional defaults for the additional OpenAI-compatible routes.
# HYPER_NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# HYPER_DEEPSEEK_MODEL=deepseek-chat
# HYPER_MISTRAL_MODEL=mistral-small-latest
# HYPER_OPENCODE_MODEL=deepseek-v4-flash-free

# Deterministic model-pass routing. Every entry is one provider/model pair.
# fallback keeps route A preferred and uses later routes only on failure.
# ping_pong requires 2 routes; ring requires 3; ring_pair requires 4. A failed
# scheduled route automatically falls through the other routes for that pass.
# HYPER_MODEL_ROUTING_MODE=ping_pong
# HYPER_MODEL_ROUTE_SCHEDULE=[{"provider":"anthropic","model":"claude-haiku-4-5-20251001"},{"provider":"groq","model":"llama-3.3-70b-versatile"}]

# Availability and quotas are controlled by each provider. Mistral offers a
# limited free mode; NVIDIA offers developer access; OpenCode marks some Zen
# models as free. DeepSeek's direct API is paid and is included as a low-cost
# route, not mislabelled as a free tier.

# Local OpenAI-compatible servers do not require a key by default.
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

# Session-owned uploads and optional OpenAI-compatible embeddings. Without an
# embedding model, retrieval visibly degrades to lexical + temporal +
# relationship ranking instead of pretending semantic vectors are active.
# HYPER_SESSION_FILE_DIR=./data/session-files
# HYPER_EMBEDDING_MODEL=text-embedding-3-small
# HYPER_EMBEDDING_BASE_URL=https://api.openai.com/v1
# HYPER_EMBEDDING_API_KEY_ENV=OPENAI_API_KEY
# HYPER_EMBEDDING_TIMEOUT_MS=20000
# HYPER_EMBEDDING_DIMENSIONS=1536
# Multiple OpenAI-compatible embedding spaces can be advertised to the UI.
# A session selects one profile before its first ingestion; that profile then
# locks because vectors from different spaces are not comparable. Unavailable
# credentials remain visible as an explicit limitation rather than falling
# back silently. Keep secrets in the named environment variables.
# HYPER_EMBEDDING_PROFILES=[{"id":"openai-small","label":"OpenAI small · balanced","model":"text-embedding-3-small","baseUrl":"https://api.openai.com/v1","apiKeyEnvironmentName":"OPENAI_API_KEY","dimensions":1536},{"id":"local-code","label":"Local code retrieval","model":"nomic-embed-code","baseUrl":"http://127.0.0.1:11434/v1","dimensions":768}]

# Bounded auto mode ceilings. A session may request a smaller step budget, but
# cannot exceed these server limits or bypass capability/approval policy.
# HYPER_AUTO_MAX_STEPS=24
# HYPER_AUTO_MAX_WALL_MS=600000

# At least one configured search provider enables the minimal `web` and the
# combined `research` capability profiles. Credentials remain backend-only.
# HYPER_SEARCH_PROVIDER_CHAIN=tavily,brave,exa,searxng
# TAVILY_API_KEY=
# BRAVE_SEARCH_KEY=
# EXA_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8088

# HYPER_MCP_CONFIG=./examples/mcp.config.example.json
# TICKET_MCP_TOKEN=

# HYPER_GATEWAY_CONFIG=./examples/gateways.config.example.json
# OPERATOR_GATEWAY_TOKEN=
# OPERATOR_GATEWAY_INGRESS_SECRET=

# Bounded media capabilities. Deepgram enables STT and TTS. ElevenLabs enables
# Scribe STT; TTS and private voice-agent sessions require explicit allowlisted
# voice/agent IDs. Keys remain server-side.
# DEEPGRAM_API_KEY=
# HYPER_DEEPGRAM_STT_MODEL=nova-3
# HYPER_DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# ELEVENLABS_API_KEY=
# HYPER_ELEVENLABS_STT_MODEL=scribe_v2
# HYPER_ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# HYPER_ELEVENLABS_VOICE_ID=
# HYPER_ELEVENLABS_AGENT_IDS=agent_example

# Gemini or OpenAI credentials automatically expose the corresponding
# approval-gated vision/image capability. Override the key environment name,
# base URL, or model here; key values are never sent to the browser.
# HYPER_VISION_API_KEY_ENV=GEMINI_API_KEY
# HYPER_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# HYPER_VISION_MODEL=gemini-flash-latest
# HYPER_IMAGE_API_KEY_ENV=OPENAI_API_KEY
# HYPER_IMAGE_BASE_URL=https://api.openai.com/v1
# HYPER_IMAGE_MODEL=gpt-image-2
# HYPER_MEDIA_TIMEOUT_MS=60000
# HYPER_IMAGE_TIMEOUT_MS=120000

# Linux process isolation. Process calls fail closed if bubblewrap is absent.
# HYPER_PROCESS_SANDBOX=bubblewrap
# HYPER_BWRAP_EXECUTABLE=bwrap
# Production-style disposable OCI isolation (image digest is required).
# HYPER_PROCESS_SANDBOX=oci
# HYPER_OCI_RUNTIME=docker
# HYPER_OCI_IMAGE=ghcr.io/your-org/hyper-worker@sha256:replace-with-immutable-digest
# HYPER_OCI_MEMORY_MB=512
# HYPER_OCI_PIDS_LIMIT=128
