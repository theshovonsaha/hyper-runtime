# The evaluated v0.1.0 core requires no environment variables or API keys.
# Future provider and capability packages must document variables here and may
# not ship default credentials.

# -----------------------------------------------------------------------------
# Optional Live Providers (for experimental usage only)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
HYPER_PROVIDER=ollama
HYPER_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
HYPER_OLLAMA_MODEL=llama3.2

# Remote providers become visible when their credential is present.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Local OpenAI-compatible servers do not require a key by default.
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
