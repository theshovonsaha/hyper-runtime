{
  "name": "hyper-runtime",
  "version": "0.2.0",
  "description": "Evidence-grounded agent runtime with dynamic context, bounded capabilities, causal recovery, and verified completion",
  "license": "MIT",
  "private": false,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bun install && bun run check",
    "start": "bun run hyper",
    "dev": "npm --prefix ui/morph-ui/shovs-frontend run dev",
    "dev:frontend": "npm --prefix ui/morph-ui/shovs-frontend run dev:frontend",
    "dev:backend": "bun run runtime:serve",
    "test": "bun test tests/*.test.ts",
    "test:legacy": "bun scripts/test_hyper_runtime.ts",
    "eval": "bun packages/evals/src/cli.ts",
    "eval:live": "bun packages/evals/src/live-provider-experiment.ts",
    "eval:live:mistral": "HYPER_LIVE_EVAL_PROVIDERS=mistral HYPER_MISTRAL_MODEL=mistral-small-2603 bun packages/evals/src/live-provider-experiment.ts",
    "eval:live:coding": "bun packages/evals/src/live-coding-experiment.ts",
    "eval:live:mistral:coding": "HYPER_LIVE_CODING=1 HYPER_LIVE_CODING_MAX_PROVIDERS=1 HYPER_LIVE_EVAL_PROVIDERS=mistral HYPER_MISTRAL_MODEL=mistral-small-2603 bun packages/evals/src/live-coding-experiment.ts",
    "eval:live:paired": "bun packages/evals/src/paired-live-experiment.ts",
    "eval:live:mistral:paired": "HYPER_LIVE_PAIRED=1 HYPER_LIVE_PAIRED_MAX_PROVIDERS=1 HYPER_LIVE_EVAL_PROVIDERS=mistral HYPER_MISTRAL_MODEL=mistral-small-2603 bun packages/evals/src/paired-live-experiment.ts",
    "eval:media": "bun packages/evals/src/live-media-experiment.ts",
    "eval:contributed": "bun packages/evals/src/contributed-experiment.ts",
    "packages:check": "bun tools/package-audit.ts",
    "process:check": "bun tools/process-diagnostics-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run typecheck && bun run test && bun run process:check && bun run eval",
    "hyper": "bun packages/cli/src/cli.ts",
    "runtime:serve": "bun packages/cli/src/server.ts",
    "release:check": "bun run check && bun run packages:check && bun packages/cli/src/cli.ts --help && npm --prefix ui/morph-ui/shovs-frontend run build",
    "legacy:start": "bun run src/index.ts",
    "legacy:dev": "bun --watch src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
